{
  "name": "@toolbuilder/isnumber",
  "version": "1.0.0",
  "description": "Well tested 'is number' checks, that can optionally include number-like strings, and non-finite values.",
  "keywords": [
    "number",
    "numeric",
    "string",
    "finite"
  ],
  "homepage": "https://github.com/toolbuilder/isnumber#readme",
  "bugs": {
    "url": "https://github.com/toolbuilder/isnumber/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolbuilder/isnumber.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/isnumber.js",
  "types": "./src/isnumber.d.ts",
  "exports": {
    ".": {
      "types": "./src/isnumber.d.ts",
      "default": "./src/isnumber.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "test": "node --test 'test/**/*.test.js'",
    "check": "pnpm run check:types && pnpm run build && pnpm test",
    "validate:package": "npx -y publint && npx -y @arethetypeswrong/cli --pack . --profile esm-only",
    "release": "changelogen --release --no-github"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "changelogen": "^0.5.7",
    "typescript": "^5.6.3"
  }
}
